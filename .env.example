# A. Sharif Commerce — environment variables
#
# Copy to .env.local for local development (never commit the real file —
# .env* besides this example is already in .gitignore). On Vercel, set
# these as Project → Settings → Environment Variables instead.
#
# Nothing in this repository ever hard-codes a real key. If these are
# unset, /api/create-checkout-session and /api/stripe-webhook both fail
# closed (503) rather than silently doing something unsafe.

# --- Stripe (TEST MODE keys only until the business is actually ready to
#     take real payments — see research/source-ledger.md and
#     PRODUCT_LIFECYCLE.md for what's still required before that's true) ---

# Secret key, server-side only. Starts with sk_test_ in test mode.
STRIPE_SECRET_KEY=

# Publishable key, safe to expose client-side. Starts with pk_test_.
# Currently unused by the static pages (checkout is server-initiated), kept
# here for when/if client-side Stripe.js elements are added later.
STRIPE_PUBLISHABLE_KEY=

# Webhook signing secret for the endpoint registered at
# https://<your-deployment>/api/stripe-webhook — from the Stripe Dashboard
# (Developers → Webhooks) or `stripe listen` in test mode. Starts with whsec_.
STRIPE_WEBHOOK_SECRET=

# --- Site ---

# REQUIRED before checkout can work. Canonical origin used to build Stripe
# success/cancel URLs server-side — deliberately never derived from the
# request's Host header (that would let a spoofed request redirect a real
# paying customer, with their live session_id, to an attacker's domain).
# /api/create-checkout-session fails closed (503) if this is unset.
# Example: https://a-sharif-commerce-shop.vercel.app
SITE_URL=
